# =============================================================================
# Ecommerce Platform - Environment Variables
# =============================================================================
# Copy this file to .env and configure the values for your environment.
#   cp .env.example .env
#
# These variables override Viper's defaults and can also be set via OS environment.
# =============================================================================

# --- Environment ---
# Set to "production" for production mode, "development" otherwise.
ENV=development

# --- Server ---
SERVER_PORT=8080
SERVER_BASE_URL=http://localhost:8080

# --- MySQL Database ---
# With Docker Compose the backend uses MYSQL_ROOT_PASSWORD and MYSQL_DATABASE (see below).
# DATABASE_* are only used when running the backend outside Docker and must match them.
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=your_db_password_here
DATABASE_NAME=your_db_name_here

# --- MySQL (used by docker-compose to create the database and run migrations) ---
MYSQL_ROOT_PASSWORD=your_db_password_here
MYSQL_DATABASE=your_db_name_here

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_DIAL_TIMEOUT=10s
REDIS_READ_TIMEOUT=10s
REDIS_WRITE_TIMEOUT=10s
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5
REDIS_MAX_RETRIES=3

# --- Resend (verification codes sent by email) ---
# Create an account and an API key at https://resend.com
# The sender must be one that your Resend account is allowed to use.
RESEND_EMAIL_API_KEY=your_resend_api_key
RESEND_EMAIL_FROM=your_sender_address

# --- JWT Security ---
SECURITY_JWT_JWT_SECRET=change_this_to_a_strong_secret
SECURITY_JWT_JWT_EXPIRATION_MINUTES=60
SECURITY_JWT_PASSWORD_MIN_LENGTH=8

# --- Rate Limiting ---
RATE_LIMITING_REQUESTS=100
RATE_LIMITING_BURST=5
RATE_LIMITING_CLEANUP_MINUTES=10
RATE_LIMITING_EXPIRATION_MINUTES=30

# --- PayPal ---
# Get your credentials from https://developer.paypal.com/dashboard/applications
PAYPAL_ACCOUNT_CLIENTID=your_paypal_client_id
PAYPAL_ACCOUNT_SECRETKEY=your_paypal_secret_key
PAYPAL_ACCOUNT_ENVIRONMENT=sandbox  # sandbox or live

# --- Cookies ---
# Optional prefix for all cookie names to avoid collisions when multiple
# applications share the same parent domain (e.g. "ecommerce_").
COOKIE_PREFIX=

# --- SSL/TLS ---
# Enable HTTPS. Set to "true" in production, "false" in development.
SSL_ENABLED=false
# Paths to certificate and key files (required only when SSL_ENABLED=true).
SSL_CERT_FILE=
SSL_KEY_FILE=

# --- Static Files ---
STATIC_DIR=./../frontend
